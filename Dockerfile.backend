# Construction : docker build -f deploiement/Dockerfile.backend -t scolaire-api .   (depuis la racine du projet)
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY backend/pom.xml .
RUN mvn -q -B dependency:go-offline
COPY backend/src ./src
RUN mvn -q -B -DskipTests package && cp target/*.jar /app.jar

FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 appli
COPY --from=build /app.jar /app/app.jar
USER appli
EXPOSE 8080
ENV SPRING_PROFILES_ACTIVE=prod FORWARD_HEADERS_STRATEGY=native JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75"
ENTRYPOINT ["java","-jar","/app/app.jar"]
